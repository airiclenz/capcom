# Generated by cmd/release in airiclenz/capcom and overwritten at each release: edit
# cmd/release/templates/capcom.rb.tmpl there, never this file.
class Capcom < Formula
  desc "Git-native issue tracker and knowledge store for coding agents"
  homepage "https://github.com/airiclenz/capcom"
  version "{{.Version}}"
  license "MIT"

  # Installs the prebuilt binary for this platform rather than compiling, so no Go
  # toolchain is needed. The tree is CGO-free, so all six release targets come off
  # one `cmd/release dist` in the project repo.
  on_macos do
    on_arm do
{{- with .Archive "darwin" "arm64"}}
      url "{{.URL}}"
      sha256 "{{.SHA256}}"
{{- end}}
    end
    on_intel do
{{- with .Archive "darwin" "amd64"}}
      url "{{.URL}}"
      sha256 "{{.SHA256}}"
{{- end}}
    end
  end

  on_linux do
    on_arm do
{{- with .Archive "linux" "arm64"}}
      url "{{.URL}}"
      sha256 "{{.SHA256}}"
{{- end}}
    end
    on_intel do
{{- with .Archive "linux" "amd64"}}
      url "{{.URL}}"
      sha256 "{{.SHA256}}"
{{- end}}
    end
  end

  def install
    bin.install "capcom"
  end

  test do
    # `capcom version` prints "capcom X.Y.Z".
    assert_match version.to_s, shell_output("#{bin}/capcom version")
  end
end
